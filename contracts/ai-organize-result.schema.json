{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://songshu.example/contracts/ai-organize-result-v1.json",
  "title": "AI organize result v1",
  "type": "object",
  "required": ["document"],
  "additionalProperties": false,
  "properties": {
    "document": {
      "type": "object",
      "required": ["title", "sections"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "sections": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "object",
            "required": ["id", "title", "summary", "points", "pineconeIds"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "minLength": 1, "maxLength": 120 },
              "title": { "type": "string", "minLength": 1, "maxLength": 200 },
              "summary": { "type": "string", "maxLength": 2000 },
              "points": { "type": "array", "maxItems": 20, "items": { "type": "string", "minLength": 1, "maxLength": 1000 } },
              "pineconeIds": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
            }
          }
        }
      }
    }
  }
}
