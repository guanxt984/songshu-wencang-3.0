{
  "openapi": "3.1.0",
  "info": { "title": "松鼠文仓公开测试版 API", "version": "1.0.0" },
  "paths": {
    "/api/auth/email-code": { "post": { "responses": { "202": { "description": "验证码已发送" }, "422": { "$ref": "#/components/responses/Error" } } } },
    "/api/auth/verify": { "post": { "responses": { "200": { "description": "登录成功" }, "422": { "$ref": "#/components/responses/Error" } } } },
    "/api/auth/session": { "get": { "responses": { "200": { "description": "当前会话" }, "401": { "$ref": "#/components/responses/Error" } } } },
    "/api/auth/logout": { "post": { "responses": { "204": { "description": "已退出" }, "401": { "$ref": "#/components/responses/Error" } } } },
    "/api/account": { "delete": { "responses": { "202": { "description": "已创建注销任务" }, "401": { "$ref": "#/components/responses/Error" } } } },
    "/api/warehouses": {
      "get": { "responses": { "200": { "description": "仓库列表" }, "401": { "$ref": "#/components/responses/Error" } } },
      "post": { "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/WarehouseCreate" } } } }, "responses": { "201": { "description": "已创建仓库" }, "409": { "$ref": "#/components/responses/Error" }, "422": { "$ref": "#/components/responses/Error" } } }
    },
    "/api/warehouses/{id}": {
      "get": { "responses": { "200": { "description": "仓库详情" }, "401": { "$ref": "#/components/responses/Error" }, "404": { "$ref": "#/components/responses/Error" } } },
      "put": { "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/WarehouseWrite" } } } }, "responses": { "200": { "description": "已保存并返回新修订号" }, "409": { "$ref": "#/components/responses/RevisionConflict" }, "422": { "$ref": "#/components/responses/Error" } } },
      "delete": { "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RevisionRequest" } } } }, "responses": { "204": { "description": "已删除" }, "409": { "$ref": "#/components/responses/Error" } } }
    },
    "/api/warehouses/order": { "put": { "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/WarehouseOrder" } } } }, "responses": { "200": { "description": "排序已保存" }, "409": { "$ref": "#/components/responses/RevisionConflict" } } } },
    "/api/import": { "post": { "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ImportRequest" } } } }, "responses": { "200": { "description": "返回幂等导入结果" }, "409": { "$ref": "#/components/responses/Error" }, "422": { "$ref": "#/components/responses/Error" } } } },
    "/api/warehouses/{id}/organize": { "post": { "responses": { "202": { "description": "已创建整理任务" }, "409": { "$ref": "#/components/responses/RevisionConflict" }, "422": { "$ref": "#/components/responses/Error" }, "429": { "$ref": "#/components/responses/Error" } } } },
    "/api/ai-jobs/{id}": { "get": { "responses": { "200": { "description": "整理任务状态" }, "401": { "$ref": "#/components/responses/Error" }, "403": { "$ref": "#/components/responses/Error" } } } }
  },
  "components": {
    "responses": {
      "Error": { "description": "稳定错误响应", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
      "RevisionConflict": { "description": "内容已在其他设备更新", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" }, "example": { "error": { "code": "REVISION_CONFLICT", "message": "内容已在其他设备更新" } } } } }
    },
    "schemas": {
      "ErrorResponse": { "type": "object", "required": ["error"], "properties": { "error": { "type": "object", "required": ["code", "message"], "properties": { "code": { "type": "string" }, "message": { "type": "string" } } } } },
      "WarehouseSnapshot": { "$ref": "./warehouse-snapshot.schema.json" },
      "WarehouseCreate": { "type": "object", "additionalProperties": false, "required": ["snapshot"], "properties": { "snapshot": { "$ref": "#/components/schemas/WarehouseSnapshot" } } },
      "RevisionRequest": { "type": "object", "additionalProperties": false, "required": ["revision"], "properties": { "revision": { "type": "integer", "minimum": 0 } } },
      "WarehouseWrite": { "type": "object", "additionalProperties": false, "required": ["revision", "snapshot"], "properties": { "revision": { "type": "integer", "minimum": 0 }, "snapshot": { "$ref": "#/components/schemas/WarehouseSnapshot" } } },
      "WarehouseOrder": { "type": "object", "additionalProperties": false, "required": ["revision", "warehouseIds"], "properties": { "revision": { "type": "integer", "minimum": 0 }, "warehouseIds": { "type": "array", "maxItems": 10, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } } } },
      "ImportRequest": { "type": "object", "additionalProperties": false, "required": ["idempotencyKey", "warehouses"], "properties": { "idempotencyKey": { "type": "string", "minLength": 1, "maxLength": 128 }, "warehouses": { "type": "array", "minItems": 1, "maxItems": 10, "items": { "$ref": "#/components/schemas/WarehouseSnapshot" } } } }
    }
  }
}
