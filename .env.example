# Copy to .env for local development or deployment. Keep every value blank in Git.
# Set APP_ENV=development and LOCAL_DEVELOPMENT_AUTH=true only for the explicit in-memory local demo.
# APP_ENV=production requires DATABASE_URL, AUTH_HASH_SECRET, CSRF_TOKEN_SECRET, and ALLOWED_ORIGINS.
# Production rejects LOCAL_DEVELOPMENT_AUTH and always sets Secure cookies.
APP_ENV=
LOCAL_DEVELOPMENT_AUTH=
APP_ORIGIN=
API_ORIGIN=

# Runtime DATABASE_URL: use a Supabase transaction-pooler URL for short-lived application connections.
# Migrations should use a Supabase direct connection URL instead; do not put it in this file or client code.
# The application pool has bounded connection, idle, and statement timeouts; size the pooler for all app instances.
DATABASE_URL=
# TEST_DATABASE_URL is only for the disposable PostgreSQL integration database. Its database name must end in _test.
TEST_DATABASE_URL=

SESSION_COOKIE_NAME=
SESSION_COOKIE_SECURE=
CSRF_TOKEN_SECRET=
AUTH_HASH_SECRET=
# Comma-separated exact origins. Production accepts HTTPS origins only, with no paths, queries, fragments, credentials, or wildcards.
ALLOWED_ORIGINS=

# A real mailer must be injected for production; no-op delivery and the fixed development code are development-only.
EMAIL_PROVIDER_ENDPOINT=
EMAIL_PROVIDER_API_KEY=
AI_PROVIDER_API_KEY=
AI_MODEL=
QUEUE_ENDPOINT=
LOG_LEVEL=
PUBLIC_BETA_USER_LIMIT=
DAILY_AI_JOB_LIMIT=
GLOBAL_DAILY_AI_JOB_LIMIT=
